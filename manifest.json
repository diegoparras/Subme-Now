{
  "manifest_version": 3,
  "name": "__MSG_extName__",
  "short_name": "__MSG_extShortName__",
  "version": "1.6.1",
  "description": "__MSG_extDescription__",
  "default_locale": "es",
  "homepage_url": "https://github.com/diegoparras/Subme-Now",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "__MSG_actionTitle__",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png"
    }
  },
  "options_ui": {
    "page": "src/options/options.html",
    "open_in_tab": true
  },
  "side_panel": {
    "default_path": "src/sidepanel/sidepanel.html"
  },
  "background": {
    "service_worker": "src/background.js"
  },
  "permissions": [
    "storage",
    "sidePanel"
  ],
  "host_permissions": [
    "https://openrouter.ai/*",
    "https://api.openai.com/*",
    "https://api.x.ai/*",
    "https://api.anthropic.com/*",
    "https://generativelanguage.googleapis.com/*"
  ],
  "optional_host_permissions": [
    "https://*/*",
    "http://*/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://www.youtube.com/*"
      ],
      "js": [
        "src/shared/utils.js",
        "src/shared/settings.js",
        "src/shared/icons.js",
        "src/shared/prompts.js",
        "src/shared/markdown.js",
        "src/content/styles.js",
        "src/content/transcript.js",
        "src/content/ai.js",
        "src/content/views.js",
        "src/content/mindmap.js",
        "src/content/export.js",
        "src/content/tts.js",
        "src/content/surfaces.js",
        "src/content/windows.js",
        "src/content/panel.js",
        "src/content/main.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://www.youtube.com/*"
      ],
      "js": [
        "src/content/page-bridge.js"
      ],
      "run_at": "document_idle",
      "world": "MAIN"
    }
  ],
  "commands": {
    "run-summary": {
      "suggested_key": {
        "default": "Alt+Shift+S"
      },
      "description": "__MSG_cmdSummary__"
    },
    "run-mindmap": {
      "suggested_key": {
        "default": "Alt+Shift+M"
      },
      "description": "__MSG_cmdMindmap__"
    },
    "toggle-panel": {
      "suggested_key": {
        "default": "Alt+Shift+Y"
      },
      "description": "__MSG_cmdToggle__"
    },
    "open-chat": {
      "suggested_key": {
        "default": "Alt+Shift+K"
      },
      "description": "__MSG_cmdChat__"
    }
  }
}
