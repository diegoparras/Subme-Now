{
  "manifest_version": 3,
  "name": "Subme Now — Transcripciones e IA para YouTube",
  "short_name": "Subme Now",
  "version": "1.0.0",
  "description": "Extrae los subtítulos de cualquier video de YouTube y genera resúmenes, capítulos, quizzes y más con OpenRouter, OpenAI, Grok, Claude o Gemini.",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "Subme Now — Configuración",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png"
    }
  },
  "options_ui": {
    "page": "src/options/options.html",
    "open_in_tab": true
  },
  "background": {
    "service_worker": "src/background.js"
  },
  "permissions": ["storage"],
  "host_permissions": [
    "https://openrouter.ai/*",
    "https://api.openai.com/*",
    "https://api.x.ai/*",
    "https://api.anthropic.com/*",
    "https://generativelanguage.googleapis.com/*"
  ],
  "optional_host_permissions": ["https://*/*", "http://*/*"],
  "content_scripts": [
    {
      "matches": ["https://www.youtube.com/*"],
      "js": [
        "src/shared/utils.js",
        "src/shared/settings.js",
        "src/shared/prompts.js",
        "src/shared/markdown.js",
        "src/content/styles.js",
        "src/content/transcript.js",
        "src/content/ai.js",
        "src/content/panel.js",
        "src/content/main.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
